  <smoothstep name="smooth_164" type="float">
    <input name="in" type="float" nodename="absny_163" />
    <input name="low" type="float" value="0.9" />
    <input name="high" type="float" value="0.98" />
  </smoothstep>
  <subtract name="sub_165" type="float">
    <input name="in1" type="float" value="1.0" />
    <input name="in2" type="float" nodename="smooth_164" />
  </subtract>
  <divide name="div_166" type="float">
    <input name="in1" type="float" nodename="sep_1" output="outy" />
    <input name="in2" type="float" value="0.18" />
  </divide>
  <floor name="floor_167" type="float">
    <input name="in" type="float" nodename="div_166" />
  </floor>
  <divide name="div_168" type="float">
    <input name="in1" type="float" nodename="sep_1" output="outy" />
    <input name="in2" type="float" value="0.18" />
  </divide>
  <subtract name="sub_169" type="float">
    <input name="in1" type="float" nodename="div_168" />
    <input name="in2" type="float" nodename="floor_167" />
  </subtract>
  <smoothstep name="smooth_170" type="float">
    <input name="in" type="float" nodename="sub_169" />
    <input name="low" type="float" value="0.0" />
    <input name="high" type="float" value="0.1" />
  </smoothstep>
  <add name="add_171" type="float">
    <input name="in1" type="float" nodename="sep_1" output="outx" />
    <input name="in2" type="float" nodename="sep_1" output="outz" />
  </add>
  <divide name="div_172" type="float">
    <input name="in1" type="float" nodename="add_171" />
    <input name="in2" type="float" value="0.32" />
  </divide>
  <modulo name="mod_173" type="float">
    <input name="in1" type="float" nodename="floor_167" />
    <input name="in2" type="float" value="2.0" />
  </modulo>
  <multiply name="mul_174" type="float">
    <input name="in1" type="float" nodename="mod_173" />
    <input name="in2" type="float" value="0.5" />
  </multiply>
  <add name="add_175" type="float">
    <input name="in1" type="float" nodename="div_172" />
    <input name="in2" type="float" nodename="mul_174" />
  </add>
  <floor name="floor_176" type="float">
    <input name="in" type="float" nodename="add_175" />
  </floor>
  <subtract name="sub_177" type="float">
    <input name="in1" type="float" nodename="add_175" />
    <input name="in2" type="float" nodename="floor_176" />
  </subtract>
  <smoothstep name="smooth_178" type="float">
    <input name="in" type="float" nodename="sub_177" />
    <input name="low" type="float" value="0.0" />
    <input name="high" type="float" value="0.05" />
  </smoothstep>
  <smoothstep name="smooth_179" type="float">
    <input name="in" type="float" nodename="sub_177" />
    <input name="low" type="float" value="0.95" />
    <input name="high" type="float" value="1.0" />
  </smoothstep>
  <subtract name="sub_180" type="float">
    <input name="in1" type="float" value="1.0" />
    <input name="in2" type="float" nodename="smooth_179" />
  </subtract>
  <multiply name="mul_181" type="float">
    <input name="in1" type="float" nodename="smooth_178" />
    <input name="in2" type="float" nodename="sub_180" />
  </multiply>
  <floor name="floor_182" type="float">
    <input name="in" type="float" nodename="add_175" />
  </floor>
  <combine3 name="roofid_183" type="vector3">
    <input name="in1" type="float" nodename="floor_182" />
    <input name="in2" type="float" nodename="floor_167" />
    <input name="in3" type="float" value="7.0" />
  </combine3>
  <cellnoise3d name="roofcell_184" type="float">
    <input name="position" type="vector3" nodename="roofid_183" />
