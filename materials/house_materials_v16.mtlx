<?xml version="1.0"?>
<!-- house_materials.mtlx : procedural facade materials (no textures, no UVs).
     Every pattern is built from WORLD position, so it works on any generated house.
     Paint colours come from the displayColor primvar written by the paint SOP. -->
<materialx version="1.38">

  <!-- ===== shared: world position, noise, palette colour ===== -->
  <position name="P_0" type="vector3">
    <input name="space" type="string" value="world" />
  </position>
  <separate3 name="sep_1" type="multioutput">
    <input name="in" type="vector3" nodename="P_0" />
  </separate3>
  <multiply name="Pbig_2" type="vector3">
    <input name="in1" type="vector3" nodename="P_0" />
    <input name="in2" type="float" value="0.6" />
  </multiply>
  <multiply name="Psmall_3" type="vector3">
    <input name="in1" type="vector3" nodename="P_0" />
    <input name="in2" type="float" value="4.0" />
  </multiply>
  <multiply name="Pfine_4" type="vector3">
    <input name="in1" type="vector3" nodename="P_0" />
    <input name="in2" type="float" value="90.0" />
  </multiply>
  <fractal3d name="fracbig_5" type="float">
    <input name="position" type="vector3" nodename="Pbig_2" />
    <input name="octaves" type="integer" value="4" />
    <input name="amplitude" type="float" value="1.0" />
  </fractal3d>
  <multiply name="mul_6" type="float">
    <input name="in1" type="float" nodename="fracbig_5" />
    <input name="in2" type="float" value="0.5" />
  </multiply>
  <add name="add_7" type="float">
    <input name="in1" type="float" nodename="mul_6" />
    <input name="in2" type="float" value="0.5" />
  </add>
  <clamp name="clamp_8" type="float">
    <input name="in" type="float" nodename="add_7" />
    <input name="low" type="float" value="0.0" />
    <input name="high" type="float" value="1.0" />
  </clamp>
  <fractal3d name="fracsmall_9" type="float">
    <input name="position" type="vector3" nodename="Psmall_3" />
    <input name="octaves" type="integer" value="4" />
    <input name="amplitude" type="float" value="1.0" />
  </fractal3d>
  <multiply name="mul_10" type="float">
    <input name="in1" type="float" nodename="fracsmall_9" />
    <input name="in2" type="float" value="0.5" />
  </multiply>
  <add name="add_11" type="float">
    <input name="in1" type="float" nodename="mul_10" />
    <input name="in2" type="float" value="0.5" />
  </add>
  <clamp name="clamp_12" type="float">
    <input name="in" type="float" nodename="add_11" />
    <input name="low" type="float" value="0.0" />
    <input name="high" type="float" value="1.0" />
  </clamp>
  <geompropvalue name="paintcolour_13" type="color3">
    <input name="geomprop" type="string" value="displayColor" />
    <input name="default" type="color3" value="0.5, 0.5, 0.5" />
  </geompropvalue>
  <smoothstep name="smooth_14" type="float">
    <input name="in" type="float" nodename="sep_1" output="outy" />
    <input name="low" type="float" value="0.0" />
    <input name="high" type="float" value="1.2" />
  </smoothstep>
  <subtract name="sub_15" type="float">
    <input name="in1" type="float" value="1.0" />
    <input name="in2" type="float" nodename="smooth_14" />
  </subtract>

  <!-- ===== siding: painted clapboards, grime near the street, optional brick base ===== -->
  <divide name="div_16" type="float">
    <input name="in1" type="float" nodename="sep_1" output="outy" />
    <input name="in2" type="float" value="0.15" />
  </divide>
  <floor name="floor_17" type="float">
    <input name="in" type="float" nodename="div_16" />
  </floor>
  <subtract name="sub_18" type="float">
    <input name="in1" type="float" nodename="div_16" />
    <input name="in2" type="float" nodename="floor_17" />
  </subtract>
  <smoothstep name="smooth_19" type="float">
    <input name="in" type="float" nodename="sub_18" />
    <input name="low" type="float" value="0.0" />
    <input name="high" type="float" value="0.12" />
  </smoothstep>
  <mix name="mix_20" type="float">
    <input name="fg" type="float" value="1.0" />
    <input name="bg" type="float" value="0.62" />
    <input name="mix" type="float" nodename="smooth_19" />
  </mix>
  <multiply name="mul_21" type="float">
    <input name="in1" type="float" nodename="sub_18" />
    <input name="in2" type="float" value="0.06" />
  </multiply>
  <add name="add_22" type="float">
    <input name="in1" type="float" nodename="mul_21" />
    <input name="in2" type="float" value="0.94" />
  </add>
  <multiply name="mul_23" type="float">
    <input name="in1" type="float" nodename="mix_20" />
    <input name="in2" type="float" nodename="add_22" />
  </multiply>
  <multiply name="cmul_24" type="color3">
    <input name="in1" type="color3" nodename="paintcolour_13" />
    <input name="in2" type="float" nodename="mul_23" />
  </multiply>
  <multiply name="mul_25" type="float">
    <input name="in1" type="float" nodename="sub_15" />
    <input name="in2" type="float" nodename="clamp_8" />
  </multiply>
  <multiply name="cmul_26" type="color3">
    <input name="in1" type="color3" nodename="cmul_24" />
    <input name="in2" type="float" value="0.55" />
  </multiply>
  <multiply name="mul_27" type="float">
    <input name="in1" type="float" nodename="mul_25" />
    <input name="in2" type="float" value="0.6" />
  </multiply>
  <mix name="mixc_28" type="color3">
    <input name="fg" type="color3" nodename="cmul_26" />
    <input name="bg" type="color3" nodename="cmul_24" />
    <input name="mix" type="float" nodename="mul_27" />
  </mix>
  <add name="add_29" type="float">
    <input name="in1" type="float" nodename="sep_1" output="outx" />
    <input name="in2" type="float" nodename="sep_1" output="outz" />
  </add>
  <divide name="div_30" type="float">
    <input name="in1" type="float" nodename="sep_1" output="outy" />
    <input name="in2" type="float" value="0.0762" />
  </divide>
  <floor name="floor_31" type="float">
    <input name="in" type="float" nodename="div_30" />
  </floor>
  <divide name="div_32" type="float">
    <input name="in1" type="float" nodename="add_29" />
    <input name="in2" type="float" value="0.2032" />
  </divide>
  <modulo name="mod_33" type="float">
    <input name="in1" type="float" nodename="floor_31" />
    <input name="in2" type="float" value="2.0" />
  </modulo>
  <multiply name="mul_34" type="float">
    <input name="in1" type="float" nodename="mod_33" />
    <input name="in2" type="float" value="0.5" />
  </multiply>
  <add name="add_35" type="float">
    <input name="in1" type="float" nodename="div_32" />
    <input name="in2" type="float" nodename="mul_34" />
  </add>
  <floor name="floor_36" type="float">
    <input name="in" type="float" nodename="add_35" />
  </floor>
  <subtract name="sub_37" type="float">
    <input name="in1" type="float" nodename="add_35" />
    <input name="in2" type="float" nodename="floor_36" />
  </subtract>
  <divide name="div_38" type="float">
    <input name="in1" type="float" nodename="sep_1" output="outy" />
    <input name="in2" type="float" value="0.0762" />
  </divide>
  <subtract name="sub_39" type="float">
    <input name="in1" type="float" nodename="div_38" />
    <input name="in2" type="float" nodename="floor_31" />
  </subtract>
  <smoothstep name="smooth_40" type="float">
    <input name="in" type="float" nodename="sub_37" />
    <input name="low" type="float" value="0.0" />
    <input name="high" type="float" value="0.05" />
  </smoothstep>
  <smoothstep name="smooth_41" type="float">
    <input name="in" type="float" nodename="sub_37" />
    <input name="low" type="float" value="0.95" />
    <input name="high" type="float" value="1.0" />
  </smoothstep>
  <subtract name="sub_42" type="float">
    <input name="in1" type="float" value="1.0" />
    <input name="in2" type="float" nodename="smooth_41" />
  </subtract>
  <multiply name="mul_43" type="float">
    <input name="in1" type="float" nodename="smooth_40" />
    <input name="in2" type="float" nodename="sub_42" />
  </multiply>
  <smoothstep name="smooth_44" type="float">
    <input name="in" type="float" nodename="sub_39" />
    <input name="low" type="float" value="0.0" />
    <input name="high" type="float" value="0.09" />
  </smoothstep>
  <smoothstep name="smooth_45" type="float">
    <input name="in" type="float" nodename="sub_39" />
    <input name="low" type="float" value="0.91" />
    <input name="high" type="float" value="1.0" />
  </smoothstep>
  <subtract name="sub_46" type="float">
    <input name="in1" type="float" value="1.0" />
    <input name="in2" type="float" nodename="smooth_45" />
  </subtract>
  <multiply name="mul_47" type="float">
    <input name="in1" type="float" nodename="smooth_44" />
    <input name="in2" type="float" nodename="sub_46" />
  </multiply>
  <multiply name="mul_48" type="float">
    <input name="in1" type="float" nodename="mul_43" />
    <input name="in2" type="float" nodename="mul_47" />
  </multiply>
  <floor name="floor_49" type="float">
    <input name="in" type="float" nodename="add_35" />
  </floor>
  <combine3 name="brickid_50" type="vector3">
    <input name="in1" type="float" nodename="floor_49" />
    <input name="in2" type="float" nodename="floor_31" />
    <input name="in3" type="float" value="0.0" />
  </combine3>
  <cellnoise3d name="brickcell_51" type="float">
    <input name="position" type="vector3" nodename="brickid_50" />
  </cellnoise3d>
  <mix name="mixc_52" type="color3">
    <input name="fg" type="color3" value="0.56, 0.25, 0.16" />
    <input name="bg" type="color3" value="0.32, 0.12, 0.08" />
    <input name="mix" type="float" nodename="brickcell_51" />
  </mix>
  <multiply name="mul_53" type="float">
    <input name="in1" type="float" nodename="clamp_12" />
    <input name="in2" type="float" value="0.3" />
  </multiply>
  <add name="add_54" type="float">
    <input name="in1" type="float" nodename="mul_53" />
    <input name="in2" type="float" value="0.85" />
  </add>
  <multiply name="cmul_55" type="color3">
    <input name="in1" type="color3" nodename="mixc_52" />
    <input name="in2" type="float" nodename="add_54" />
  </multiply>
  <mix name="mixc_56" type="color3">
    <input name="fg" type="color3" nodename="cmul_55" />
    <input name="bg" type="color3" value="0.62, 0.6, 0.56" />
    <input name="mix" type="float" nodename="mul_48" />
  </mix>
  <geompropvalue name="basebrick_57" type="float">
    <input name="geomprop" type="string" value="base_brick" />
    <input name="default" type="float" value="0.0" />
  </geompropvalue>
  <geompropvalue name="basetop_58" type="float">
    <input name="geomprop" type="string" value="base_top" />
    <input name="default" type="float" value="0.0" />
  </geompropvalue>
  <ifgreater name="ifgt_59" type="float">
    <input name="value1" type="float" nodename="basetop_58" />
    <input name="value2" type="float" nodename="sep_1" output="outy" />
    <input name="in1" type="float" value="1.0" />
    <input name="in2" type="float" value="0.0" />
  </ifgreater>
  <multiply name="mul_60" type="float">
    <input name="in1" type="float" nodename="basebrick_57" />
    <input name="in2" type="float" nodename="ifgt_59" />
  </multiply>
  <mix name="mixc_61" type="color3">
    <input name="fg" type="color3" nodename="mixc_56" />
    <input name="bg" type="color3" nodename="mixc_28" />
    <input name="mix" type="float" nodename="mul_60" />
  </mix>
  <multiply name="mul_62" type="float">
    <input name="in1" type="float" nodename="clamp_12" />
    <input name="in2" type="float" value="0.15" />
  </multiply>
  <add name="add_63" type="float">
    <input name="in1" type="float" nodename="mul_62" />
    <input name="in2" type="float" value="0.5" />
  </add>
  <mix name="mix_64" type="float">
    <input name="fg" type="float" value="0.85" />
    <input name="bg" type="float" nodename="add_63" />
    <input name="mix" type="float" nodename="mul_60" />
  </mix>
  <standard_surface name="siding_shader_65" type="surfaceshader">
    <input name="base_color" type="color3" nodename="mixc_61" />
    <input name="specular" type="float" value="0.35" />
    <input name="specular_roughness" type="float" nodename="mix_64" />
  </standard_surface>
  <surfacematerial name="siding" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="siding_shader_65" />
  </surfacematerial>

  <!-- ===== trim, sash, door: painted wood ===== -->
  <multiply name="cmul_66" type="color3">
    <input name="in1" type="color3" nodename="paintcolour_13" />
    <input name="in2" type="float" value="0.7" />
  </multiply>
  <multiply name="mul_67" type="float">
    <input name="in1" type="float" nodename="clamp_12" />
    <input name="in2" type="float" value="0.04" />
  </multiply>
  <add name="add_68" type="float">
    <input name="in1" type="float" nodename="mul_67" />
    <input name="in2" type="float" value="0.96" />
  </add>
  <multiply name="cmul_69" type="color3">
    <input name="in1" type="color3" nodename="paintcolour_13" />
    <input name="in2" type="float" nodename="add_68" />
  </multiply>
  <multiply name="mul_70" type="float">
    <input name="in1" type="float" nodename="mul_25" />
    <input name="in2" type="float" value="0.4" />
  </multiply>
  <mix name="mixc_71" type="color3">
    <input name="fg" type="color3" nodename="cmul_66" />
    <input name="bg" type="color3" nodename="cmul_69" />
    <input name="mix" type="float" nodename="mul_70" />
  </mix>
  <multiply name="mul_72" type="float">
    <input name="in1" type="float" nodename="clamp_12" />
    <input name="in2" type="float" value="0.1" />
  </multiply>
  <add name="add_73" type="float">
    <input name="in1" type="float" nodename="mul_72" />
    <input name="in2" type="float" value="0.3" />
  </add>
  <standard_surface name="trim_shader_74" type="surfaceshader">
    <input name="base_color" type="color3" nodename="mixc_71" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_roughness" type="float" nodename="add_73" />
  </standard_surface>
  <surfacematerial name="trim" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="trim_shader_74" />
  </surfacematerial>
  <standard_surface name="sash_shader_75" type="surfaceshader">
    <input name="base_color" type="color3" nodename="paintcolour_13" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_roughness" type="float" value="0.25" />
  </standard_surface>
  <surfacematerial name="sash" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="sash_shader_75" />
  </surfacematerial>
  <standard_surface name="door_shader_76" type="surfaceshader">
    <input name="base_color" type="color3" nodename="paintcolour_13" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_roughness" type="float" value="0.3" />
    <input name="coat" type="float" value="1.0" />
    <input name="coat_roughness" type="float" value="0.08" />
  </standard_surface>
  <surfacematerial name="door" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="door_shader_76" />
  </surfacematerial>

  <!-- ===== glass: clear and thin, so the room / curtains behind it show through, with real reflections ===== -->
  <standard_surface name="glass_shader_77" type="surfaceshader">
    <input name="base" type="float" value="0.0" />
    <input name="specular" type="float" value="1.0" />
    <input name="specular_IOR" type="float" value="1.52" />
    <input name="specular_roughness" type="float" value="0.0" />
    <input name="transmission" type="float" value="1.0" />
    <input name="transmission_color" type="color3" value="0.93, 0.96, 0.95" />
    <input name="thin_walled" type="boolean" value="true" />
  </standard_surface>
  <surfacematerial name="glass" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="glass_shader_77" />
  </surfacematerial>

  <!-- ===== glass_dark: garage + door glass (nothing modelled behind it): dark and reflective ===== -->
  <standard_surface name="glass_dark_shader_78" type="surfaceshader">
    <input name="base_color" type="color3" value="0.008, 0.008, 0.009" />
    <input name="base" type="float" value="1.0" />
    <input name="specular" type="float" value="1.0" />
    <input name="specular_IOR" type="float" value="1.52" />
    <input name="specular_roughness" type="float" value="0.0" />
    <input name="coat" type="float" value="1.0" />
    <input name="coat_IOR" type="float" value="1.5" />
  </standard_surface>
  <surfacematerial name="glass_dark" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="glass_dark_shader_78" />
  </surfacematerial>

  <!-- ===== curtains, blinds, rooms, plants (colours come from the window_dressing node) ===== -->
  <standard_surface name="curtain_shader_79" type="surfaceshader">
    <input name="base_color" type="color3" nodename="paintcolour_13" />
    <input name="specular" type="float" value="0.1" />
    <input name="specular_roughness" type="float" value="0.8" />
    <input name="sheen" type="float" value="0.6" />
    <input name="sheen_color" type="color3" value="1.0, 1.0, 1.0" />
    <input name="thin_walled" type="boolean" value="true" />
  </standard_surface>
  <surfacematerial name="curtain" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="curtain_shader_79" />
  </surfacematerial>
  <standard_surface name="curtain_sheer_shader_80" type="surfaceshader">
    <input name="base_color" type="color3" nodename="paintcolour_13" />
    <input name="specular" type="float" value="0.05" />
    <input name="specular_roughness" type="float" value="0.9" />
    <input name="sheen" type="float" value="0.4" />
    <input name="opacity" type="color3" value="0.55, 0.55, 0.55" />
    <input name="thin_walled" type="boolean" value="true" />
  </standard_surface>
  <surfacematerial name="curtain_sheer" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="curtain_sheer_shader_80" />
  </surfacematerial>
  <geompropvalue name="roomlit_81" type="float">
    <input name="geomprop" type="string" value="lit" />
    <input name="default" type="float" value="1.0" />
  </geompropvalue>
  <geompropvalue name="glowt_82" type="float">
    <input name="geomprop" type="string" value="glow_t" />
    <input name="default" type="float" value="0.5" />
  </geompropvalue>
  <multiply name="mul_83" type="float">
    <input name="in1" type="float" nodename="glowt_82" />
    <input name="in2" type="float" nodename="glowt_82" />
  </multiply>
  <convert name="cdvec_84" type="vector3">
    <input name="in" type="color3" nodename="paintcolour_13" />
  </convert>
  <dotproduct name="cdlum_85" type="float">
    <input name="in1" type="vector3" nodename="cdvec_84" />
    <input name="in2" type="vector3" value="0.3, 0.55, 0.15" />
  </dotproduct>
  <mix name="mixc_86" type="color3">
    <input name="fg" type="color3" value="1.0, 0.93, 0.82" />
    <input name="bg" type="color3" value="1.0, 0.58, 0.26" />
    <input name="mix" type="float" nodename="mul_83" />
  </mix>
  <multiply name="mul_87" type="float">
    <input name="in1" type="float" nodename="roomlit_81" />
    <input name="in2" type="float" value="1.4" />
  </multiply>
  <multiply name="mul_88" type="float">
    <input name="in1" type="float" nodename="cdlum_85" />
    <input name="in2" type="float" value="14.0" />
  </multiply>
  <clamp name="clamp_89" type="float">
    <input name="in" type="float" nodename="mul_88" />
    <input name="low" type="float" value="0.0" />
    <input name="high" type="float" value="1.0" />
  </clamp>
  <multiply name="mul_90" type="float">
    <input name="in1" type="float" nodename="mul_87" />
    <input name="in2" type="float" nodename="clamp_89" />
  </multiply>
  <multiply name="cmul_91" type="color3">
    <input name="in1" type="color3" nodename="mixc_86" />
    <input name="in2" type="float" nodename="mul_90" />
  </multiply>
  <standard_surface name="room_shader_92" type="surfaceshader">
    <input name="base_color" type="color3" nodename="paintcolour_13" />
    <input name="specular" type="float" value="0.05" />
    <input name="specular_roughness" type="float" value="1.0" />
    <input name="emission" type="float" value="1.0" />
    <input name="emission_color" type="color3" nodename="cmul_91" />
  </standard_surface>
  <surfacematerial name="room" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="room_shader_92" />
  </surfacematerial>
  <standard_surface name="plant_shader_93" type="surfaceshader">
    <input name="base_color" type="color3" nodename="paintcolour_13" />
    <input name="specular" type="float" value="0.3" />
    <input name="specular_roughness" type="float" value="0.5" />
    <input name="subsurface" type="float" value="0.2" />
    <input name="subsurface_color" type="color3" nodename="paintcolour_13" />
    <input name="thin_walled" type="boolean" value="true" />
  </standard_surface>
  <surfacematerial name="plant" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="plant_shader_93" />
  </surfacematerial>

  <!-- ===== garage door: clean painted metal, only a faint darkening at the street ===== -->
  <multiply name="cmul_94" type="color3">
    <input name="in1" type="color3" nodename="paintcolour_13" />
    <input name="in2" type="float" value="0.8" />
  </multiply>
  <smoothstep name="smooth_95" type="float">
    <input name="in" type="float" nodename="sep_1" output="outy" />
    <input name="low" type="float" value="0.0" />
    <input name="high" type="float" value="0.5" />
  </smoothstep>
  <subtract name="sub_96" type="float">
    <input name="in1" type="float" value="1.0" />
    <input name="in2" type="float" nodename="smooth_95" />
  </subtract>
  <multiply name="mul_97" type="float">
    <input name="in1" type="float" nodename="sub_96" />
    <input name="in2" type="float" value="0.3" />
  </multiply>
  <mix name="mixc_98" type="color3">
    <input name="fg" type="color3" nodename="cmul_94" />
    <input name="bg" type="color3" nodename="paintcolour_13" />
    <input name="mix" type="float" nodename="mul_97" />
  </mix>
  <standard_surface name="garage_shader_99" type="surfaceshader">
    <input name="base_color" type="color3" nodename="mixc_98" />
    <input name="specular" type="float" value="0.6" />
    <input name="specular_roughness" type="float" value="0.35" />
  </standard_surface>
  <surfacematerial name="garage" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="garage_shader_99" />
  </surfacematerial>

  <!-- ===== iron: dark painted metal with rust spots ===== -->
  <multiply name="mul_100" type="float">
    <input name="in1" type="float" nodename="clamp_8" />
    <input name="in2" type="float" value="0.3" />
  </multiply>
  <add name="add_101" type="float">
    <input name="in1" type="float" nodename="mul_100" />
    <input name="in2" type="float" value="0.85" />
  </add>
  <multiply name="cmul_102" type="color3">
    <input name="in1" type="color3" value="0.42, 0.28, 0.17" />
    <input name="in2" type="float" nodename="add_101" />
  </multiply>
  <smoothstep name="smooth_103" type="float">
    <input name="in" type="float" nodename="clamp_12" />
    <input name="low" type="float" value="0.62" />
    <input name="high" type="float" value="0.8" />
  </smoothstep>
  <multiply name="mul_104" type="float">
    <input name="in1" type="float" nodename="smooth_103" />
    <input name="in2" type="float" value="0.6" />
  </multiply>
  <mix name="mixc_105" type="color3">
    <input name="fg" type="color3" nodename="cmul_102" />
    <input name="bg" type="color3" value="0.035, 0.035, 0.04" />
    <input name="mix" type="float" nodename="mul_104" />
  </mix>
  <mix name="mix_106" type="float">
    <input name="fg" type="float" value="0.0" />
    <input name="bg" type="float" value="0.6" />
    <input name="mix" type="float" nodename="mul_104" />
  </mix>
  <mix name="mix_107" type="float">
    <input name="fg" type="float" value="0.9" />
    <input name="bg" type="float" value="0.4" />
    <input name="mix" type="float" nodename="mul_104" />
  </mix>
  <standard_surface name="iron_shader_108" type="surfaceshader">
    <input name="base_color" type="color3" nodename="mixc_105" />
    <input name="metalness" type="float" nodename="mix_106" />
    <input name="specular_roughness" type="float" nodename="mix_107" />
  </standard_surface>
  <surfacematerial name="iron" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="iron_shader_108" />
  </surfacematerial>

  <!-- ===== granite steps: speckled grey ===== -->
  <cellnoise3d name="speck_109" type="float">
    <input name="position" type="vector3" nodename="Pfine_4" />
  </cellnoise3d>
  <mix name="mixc_110" type="color3">
    <input name="fg" type="color3" value="0.72, 0.71, 0.68" />
    <input name="bg" type="color3" value="0.44, 0.43, 0.42" />
    <input name="mix" type="float" nodename="speck_109" />
  </mix>
  <ifgreater name="ifgt_111" type="float">
    <input name="value1" type="float" nodename="speck_109" />
    <input name="value2" type="float" value="0.93" />
    <input name="in1" type="float" value="1.0" />
    <input name="in2" type="float" value="0.0" />
  </ifgreater>
  <mix name="mixc_112" type="color3">
    <input name="fg" type="color3" value="0.12, 0.12, 0.12" />
    <input name="bg" type="color3" nodename="mixc_110" />
    <input name="mix" type="float" nodename="ifgt_111" />
  </mix>
  <multiply name="mul_113" type="float">
    <input name="in1" type="float" nodename="clamp_8" />
    <input name="in2" type="float" value="0.2" />
  </multiply>
  <add name="add_114" type="float">
    <input name="in1" type="float" nodename="mul_113" />
    <input name="in2" type="float" value="0.9" />
  </add>
  <multiply name="cmul_115" type="color3">
    <input name="in1" type="color3" nodename="mixc_112" />
    <input name="in2" type="float" nodename="add_114" />
  </multiply>
  <standard_surface name="granite_shader_116" type="surfaceshader">
    <input name="base_color" type="color3" nodename="cmul_115" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_roughness" type="float" value="0.45" />
  </standard_surface>
  <surfacematerial name="granite" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="granite_shader_116" />
  </surfacematerial>

  <!-- ===== marble steps: white with grey veins (Italianate entries) ===== -->
  <multiply name="mul_117" type="float">
    <input name="in1" type="float" nodename="sep_1" output="outy" />
    <input name="in2" type="float" value="0.5" />
  </multiply>
  <add name="add_118" type="float">
    <input name="in1" type="float" nodename="sep_1" output="outx" />
    <input name="in2" type="float" nodename="mul_117" />
  </add>
  <add name="add_119" type="float">
    <input name="in1" type="float" nodename="add_118" />
    <input name="in2" type="float" nodename="sep_1" output="outz" />
  </add>
  <multiply name="mul_120" type="float">
    <input name="in1" type="float" nodename="add_119" />
    <input name="in2" type="float" value="4.0" />
  </multiply>
  <multiply name="Pvein_121" type="vector3">
    <input name="in1" type="vector3" nodename="P_0" />
    <input name="in2" type="float" value="1.5" />
  </multiply>
  <fractal3d name="veinwarp_122" type="float">
    <input name="position" type="vector3" nodename="Pvein_121" />
    <input name="octaves" type="integer" value="5" />
  </fractal3d>
  <multiply name="mul_123" type="float">
    <input name="in1" type="float" nodename="veinwarp_122" />
    <input name="in2" type="float" value="6.0" />
  </multiply>
  <add name="add_124" type="float">
    <input name="in1" type="float" nodename="mul_120" />
    <input name="in2" type="float" nodename="mul_123" />
  </add>
  <sin name="sin_125" type="float">
    <input name="in" type="float" nodename="add_124" />
  </sin>
  <absval name="abs_126" type="float">
    <input name="in" type="float" nodename="sin_125" />
  </absval>
  <smoothstep name="smooth_127" type="float">
    <input name="in" type="float" nodename="abs_126" />
    <input name="low" type="float" value="0.0" />
    <input name="high" type="float" value="0.15" />
