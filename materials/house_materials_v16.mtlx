  <multiply name="mul_187" type="float">
    <input name="in1" type="float" nodename="mix_185" />
    <input name="in2" type="float" nodename="mix_186" />
  </multiply>
  <multiply name="mul_188" type="float">
    <input name="in1" type="float" nodename="roofcell_184" />
    <input name="in2" type="float" value="0.25" />
  </multiply>
  <add name="add_189" type="float">
    <input name="in1" type="float" nodename="mul_188" />
    <input name="in2" type="float" value="0.85" />
