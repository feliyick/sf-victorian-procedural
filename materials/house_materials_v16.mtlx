  <!-- ===== sidewalk: concrete slabs with joints and stains ===== -->
  <divide name="div_197" type="float">
    <input name="in1" type="float" nodename="sep_1" output="outx" />
    <input name="in2" type="float" value="1.5" />
  </divide>
  <floor name="floor_198" type="float">
    <input name="in" type="float" nodename="div_197" />
