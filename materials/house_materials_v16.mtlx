  <mix name="mix_185" type="float">
    <input name="fg" type="float" value="1.0" />
    <input name="bg" type="float" value="0.6" />
    <input name="mix" type="float" nodename="smooth_170" />
  </mix>
  <mix name="mix_186" type="float">
    <input name="fg" type="float" value="1.0" />
    <input name="bg" type="float" value="0.75" />
    <input name="mix" type="float" nodename="mul_181" />
