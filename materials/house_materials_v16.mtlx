  <subtract name="sub_199" type="float">
    <input name="in1" type="float" nodename="div_197" />
    <input name="in2" type="float" nodename="floor_198" />
  </subtract>
  <divide name="div_200" type="float">
    <input name="in1" type="float" nodename="sep_1" output="outz" />
    <input name="in2" type="float" value="1.5" />
  </divide>
  <floor name="floor_201" type="float">
    <input name="in" type="float" nodename="div_200" />
  </floor>
  <subtract name="sub_202" type="float">
    <input name="in1" type="float" nodename="div_200" />
    <input name="in2" type="float" nodename="floor_201" />
  </subtract>
  <smoothstep name="smooth_203" type="float">
    <input name="in" type="float" nodename="sub_199" />
    <input name="low" type="float" value="0.0" />
    <input name="high" type="float" value="0.008" />
  </smoothstep>
  <smoothstep name="smooth_204" type="float">
    <input name="in" type="float" nodename="sub_199" />
    <input name="low" type="float" value="0.992" />
    <input name="high" type="float" value="1.0" />
  </smoothstep>
  <subtract name="sub_205" type="float">
    <input name="in1" type="float" value="1.0" />
    <input name="in2" type="float" nodename="smooth_204" />
  </subtract>
  <multiply name="mul_206" type="float">
    <input name="in1" type="float" nodename="smooth_203" />
    <input name="in2" type="float" nodename="sub_205" />
  </multiply>
  <smoothstep name="smooth_207" type="float">
    <input name="in" type="float" nodename="sub_202" />
    <input name="low" type="float" value="0.0" />
    <input name="high" type="float" value="0.008" />
  </smoothstep>
  <smoothstep name="smooth_208" type="float">
    <input name="in" type="float" nodename="sub_202" />
    <input name="low" type="float" value="0.992" />
    <input name="high" type="float" value="1.0" />
  </smoothstep>
  <subtract name="sub_209" type="float">
    <input name="in1" type="float" value="1.0" />
    <input name="in2" type="float" nodename="smooth_208" />
  </subtract>
  <multiply name="mul_210" type="float">
    <input name="in1" type="float" nodename="smooth_207" />
    <input name="in2" type="float" nodename="sub_209" />
  </multiply>
  <multiply name="mul_211" type="float">
    <input name="in1" type="float" nodename="mul_206" />
    <input name="in2" type="float" nodename="mul_210" />
  </multiply>
  <mix name="mix_212" type="float">
    <input name="fg" type="float" value="1.0" />
    <input name="bg" type="float" value="0.55" />
    <input name="mix" type="float" nodename="mul_211" />
  </mix>
  <multiply name="mul_213" type="float">
    <input name="in1" type="float" nodename="clamp_8" />
    <input name="in2" type="float" value="0.3" />
  </multiply>
  <add name="add_214" type="float">
    <input name="in1" type="float" nodename="mul_213" />
    <input name="in2" type="float" value="0.85" />
  </add>
  <multiply name="mul_215" type="float">
    <input name="in1" type="float" nodename="mix_212" />
    <input name="in2" type="float" nodename="add_214" />
  </multiply>
  <multiply name="cmul_216" type="color3">
    <input name="in1" type="color3" value="0.56, 0.55, 0.53" />
    <input name="in2" type="float" nodename="mul_215" />
  </multiply>
  <standard_surface name="concrete_shader_217" type="surfaceshader">
    <input name="base_color" type="color3" nodename="cmul_216" />
    <input name="specular" type="float" value="0.3" />
    <input name="specular_roughness" type="float" value="0.8" />
  </standard_surface>
  <surfacematerial name="concrete" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="concrete_shader_217" />
  </surfacematerial>

  <!-- ===== asphalt: aggregate speckle over the patch colour, darker oily centre of each lane ===== -->
  <cellnoise3d name="aggregate_218" type="float">
    <input name="position" type="vector3" nodename="Pfine_4" />
  </cellnoise3d>
  <multiply name="mul_219" type="float">
    <input name="in1" type="float" nodename="aggregate_218" />
    <input name="in2" type="float" value="0.35" />
  </multiply>
  <add name="add_220" type="float">
    <input name="in1" type="float" nodename="mul_219" />
    <input name="in2" type="float" value="0.8" />
  </add>
  <multiply name="mul_221" type="float">
    <input name="in1" type="float" nodename="clamp_8" />
    <input name="in2" type="float" value="0.3" />
  </multiply>
  <add name="add_222" type="float">
    <input name="in1" type="float" nodename="mul_221" />
    <input name="in2" type="float" value="0.85" />
  </add>
  <multiply name="mul_223" type="float">
    <input name="in1" type="float" nodename="add_220" />
    <input name="in2" type="float" nodename="add_222" />
  </multiply>
  <multiply name="cmul_224" type="color3">
    <input name="in1" type="color3" nodename="paintcolour_13" />
    <input name="in2" type="float" nodename="mul_223" />
  </multiply>
  <multiply name="mul_225" type="float">
    <input name="in1" type="float" nodename="clamp_12" />
    <input name="in2" type="float" value="0.15" />
  </multiply>
  <add name="add_226" type="float">
    <input name="in1" type="float" nodename="mul_225" />
    <input name="in2" type="float" value="0.75" />
  </add>
  <standard_surface name="asphalt_shader_227" type="surfaceshader">
    <input name="base_color" type="color3" nodename="cmul_224" />
    <input name="specular" type="float" value="0.25" />
    <input name="specular_roughness" type="float" nodename="add_226" />
  </standard_surface>
  <surfacematerial name="asphalt" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="asphalt_shader_227" />
  </surfacematerial>

  <!-- ===== sidewalk: concrete slabs, each slab tinted by Cd, stains from noise ===== -->
  <multiply name="mul_228" type="float">
    <input name="in1" type="float" nodename="clamp_8" />
    <input name="in2" type="float" value="0.3" />
  </multiply>
  <add name="add_229" type="float">
    <input name="in1" type="float" nodename="mul_228" />
    <input name="in2" type="float" value="0.82" />
  </add>
  <multiply name="mul_230" type="float">
    <input name="in1" type="float" nodename="aggregate_218" />
    <input name="in2" type="float" value="0.08" />
  </multiply>
  <add name="add_231" type="float">
    <input name="in1" type="float" nodename="mul_230" />
    <input name="in2" type="float" value="0.96" />
  </add>
  <multiply name="mul_232" type="float">
    <input name="in1" type="float" nodename="add_229" />
    <input name="in2" type="float" nodename="add_231" />
  </multiply>
  <multiply name="cmul_233" type="color3">
    <input name="in1" type="color3" nodename="paintcolour_13" />
    <input name="in2" type="float" nodename="mul_232" />
  </multiply>
  <standard_surface name="sidewalk_shader_234" type="surfaceshader">
    <input name="base_color" type="color3" nodename="cmul_233" />
    <input name="specular" type="float" value="0.3" />
    <input name="specular_roughness" type="float" value="0.85" />
  </standard_surface>
  <surfacematerial name="sidewalk" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="sidewalk_shader_234" />
  </surfacematerial>

  <!-- ===== soil / bark / leaves / painted metal / road paint ===== -->
  <multiply name="mul_235" type="float">
    <input name="in1" type="float" nodename="clamp_12" />
    <input name="in2" type="float" value="0.4" />
  </multiply>
  <add name="add_236" type="float">
    <input name="in1" type="float" nodename="mul_235" />
    <input name="in2" type="float" value="0.75" />
  </add>
  <multiply name="cmul_237" type="color3">
    <input name="in1" type="color3" nodename="paintcolour_13" />
    <input name="in2" type="float" nodename="add_236" />
  </multiply>
  <standard_surface name="soil_shader_238" type="surfaceshader">
    <input name="base_color" type="color3" nodename="cmul_237" />
    <input name="specular" type="float" value="0.1" />
    <input name="specular_roughness" type="float" value="1.0" />
  </standard_surface>
  <surfacematerial name="soil" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="soil_shader_238" />
  </surfacematerial>
  <multiply name="Pbark_239" type="vector3">
    <input name="in1" type="vector3" nodename="P_0" />
    <input name="in2" type="vector3" value="14.0, 1.5, 14.0" />
  </multiply>
  <fractal3d name="barkn_240" type="float">
    <input name="position" type="vector3" nodename="Pbark_239" />
    <input name="octaves" type="integer" value="3" />
    <input name="amplitude" type="float" value="1.0" />
  </fractal3d>
  <multiply name="mul_241" type="float">
    <input name="in1" type="float" nodename="barkn_240" />
    <input name="in2" type="float" value="0.5" />
  </multiply>
  <add name="add_242" type="float">
    <input name="in1" type="float" nodename="mul_241" />
    <input name="in2" type="float" value="0.5" />
  </add>
  <clamp name="clamp_243" type="float">
    <input name="in" type="float" nodename="add_242" />
    <input name="low" type="float" value="0.0" />
    <input name="high" type="float" value="1.0" />
  </clamp>
  <multiply name="mul_244" type="float">
    <input name="in1" type="float" nodename="clamp_243" />
    <input name="in2" type="float" value="0.5" />
  </multiply>
  <add name="add_245" type="float">
    <input name="in1" type="float" nodename="mul_244" />
    <input name="in2" type="float" value="0.6" />
  </add>
  <multiply name="cmul_246" type="color3">
    <input name="in1" type="color3" nodename="paintcolour_13" />
    <input name="in2" type="float" nodename="add_245" />
  </multiply>
  <standard_surface name="bark_shader_247" type="surfaceshader">
    <input name="base_color" type="color3" nodename="cmul_246" />
    <input name="specular" type="float" value="0.15" />
    <input name="specular_roughness" type="float" value="0.9" />
  </standard_surface>
  <surfacematerial name="bark" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="bark_shader_247" />
  </surfacematerial>
  <multiply name="mul_248" type="float">
    <input name="in1" type="float" nodename="clamp_12" />
    <input name="in2" type="float" value="0.35" />
  </multiply>
  <add name="add_249" type="float">
    <input name="in1" type="float" nodename="mul_248" />
    <input name="in2" type="float" value="0.8" />
  </add>
  <multiply name="cmul_250" type="color3">
    <input name="in1" type="color3" nodename="paintcolour_13" />
    <input name="in2" type="float" nodename="add_249" />
  </multiply>
  <standard_surface name="leaf_shader_251" type="surfaceshader">
    <input name="base_color" type="color3" nodename="cmul_250" />
    <input name="specular" type="float" value="0.25" />
    <input name="specular_roughness" type="float" value="0.55" />
    <input name="subsurface" type="float" value="0.25" />
    <input name="subsurface_color" type="color3" nodename="paintcolour_13" />
    <input name="thin_walled" type="boolean" value="true" />
  </standard_surface>
  <surfacematerial name="leaf" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="leaf_shader_251" />
  </surfacematerial>
  <multiply name="mul_252" type="float">
    <input name="in1" type="float" nodename="clamp_12" />
    <input name="in2" type="float" value="0.15" />
  </multiply>
  <add name="add_253" type="float">
    <input name="in1" type="float" nodename="mul_252" />
    <input name="in2" type="float" value="0.3" />
  </add>
  <standard_surface name="metal_shader_254" type="surfaceshader">
    <input name="base_color" type="color3" nodename="paintcolour_13" />
    <input name="specular" type="float" value="0.6" />
    <input name="specular_roughness" type="float" nodename="add_253" />
  </standard_surface>
  <surfacematerial name="metal" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="metal_shader_254" />
  </surfacematerial>
  <multiply name="mul_255" type="float">
    <input name="in1" type="float" nodename="aggregate_218" />
    <input name="in2" type="float" value="0.25" />
  </multiply>
  <add name="add_256" type="float">
    <input name="in1" type="float" nodename="mul_255" />
    <input name="in2" type="float" value="0.8" />
  </add>
  <multiply name="cmul_257" type="color3">
    <input name="in1" type="color3" nodename="paintcolour_13" />
    <input name="in2" type="float" nodename="add_256" />
  </multiply>
  <standard_surface name="street_paint_shader_258" type="surfaceshader">
    <input name="base_color" type="color3" nodename="cmul_257" />
    <input name="specular" type="float" value="0.3" />
    <input name="specular_roughness" type="float" value="0.7" />
  </standard_surface>
  <surfacematerial name="street_paint" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="street_paint_shader_258" />
  </surfacematerial>

  <!-- ===== lamp: street lamp + porch light glass (the Dusk look turns emission up) ===== -->
  <geompropvalue name="lampon_259" type="float">
    <input name="geomprop" type="string" value="lamp_on" />
    <input name="default" type="float" value="0.0" />
  </geompropvalue>
  <multiply name="mul_260" type="float">
    <input name="in1" type="float" nodename="lampon_259" />
    <input name="in2" type="float" value="12.0" />
  </multiply>
  <standard_surface name="lamp_shader_261" type="surfaceshader">
    <input name="base_color" type="color3" value="0.55, 0.53, 0.48" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_roughness" type="float" value="0.2" />
    <input name="emission" type="float" nodename="mul_260" />
    <input name="emission_color" type="color3" value="1.0, 0.78, 0.45" />
  </standard_surface>
  <surfacematerial name="lamp" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="lamp_shader_261" />
  </surfacematerial>

  <!-- ===== clouds: a lit, cut-out cloud layer on a high dome (km-scale noise), shaded by the real sun + sky ===== -->
  <multiply name="Pcloud_262" type="vector3">
    <input name="in1" type="vector3" nodename="P_0" />
    <input name="in2" type="vector3" value="0.0007, 0.004, 0.0028" />
  </multiply>
  <fractal3d name="cloudn_263" type="float">
    <input name="position" type="vector3" nodename="Pcloud_262" />
    <input name="octaves" type="integer" value="5" />
    <input name="amplitude" type="float" value="1.0" />
  </fractal3d>
  <multiply name="mul_264" type="float">
    <input name="in1" type="float" nodename="cloudn_263" />
    <input name="in2" type="float" value="0.5" />
  </multiply>
  <add name="add_265" type="float">
    <input name="in1" type="float" nodename="mul_264" />
    <input name="in2" type="float" value="0.5" />
  </add>
  <clamp name="clamp_266" type="float">
    <input name="in" type="float" nodename="add_265" />
    <input name="low" type="float" value="0.0" />
    <input name="high" type="float" value="1.0" />
  </clamp>
  <smoothstep name="smooth_267" type="float">
    <input name="in" type="float" nodename="clamp_266" />
    <input name="low" type="float" value="0.6" />
    <input name="high" type="float" value="0.85" />
  </smoothstep>
  <multiply name="mul_268" type="float">
    <input name="in1" type="float" nodename="smooth_267" />
    <input name="in2" type="float" value="0.8" />
  </multiply>
  <mix name="mixc_269" type="color3">
    <input name="fg" type="color3" value="1.0, 1.0, 1.0" />
    <input name="bg" type="color3" value="0.0, 0.0, 0.0" />
    <input name="mix" type="float" nodename="mul_268" />
  </mix>
  <standard_surface name="clouds_shader_270" type="surfaceshader">
    <input name="base_color" type="color3" value="1.0, 0.98, 0.96" />
    <input name="base" type="float" value="0.8" />
    <input name="specular" type="float" value="0.0" />
    <input name="emission" type="float" value="0.35" />
    <input name="emission_color" type="color3" value="1.0, 0.97, 0.94" />
    <input name="opacity" type="color3" nodename="mixc_269" />
    <input name="thin_walled" type="boolean" value="true" />
  </standard_surface>
  <surfacematerial name="clouds" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="clouds_shader_270" />
  </surfacematerial>

  <!-- ===== sky: an emissive backdrop, colour from displayColor (the night sky dome geometry) ===== -->
  <geompropvalue name="skycol_271" type="color3">
    <input name="geomprop" type="string" value="skycol" />
    <input name="default" type="color3" value="0.02, 0.03, 0.08" />
  </geompropvalue>
  <standard_surface name="sky_shader_272" type="surfaceshader">
    <input name="base" type="float" value="0.0" />
    <input name="specular" type="float" value="0.0" />
    <input name="emission" type="float" value="1.0" />
    <input name="emission_color" type="color3" nodename="skycol_271" />
  </standard_surface>
  <surfacematerial name="sky" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="sky_shader_272" />
  </surfacematerial>
</materialx>
