  <subtract name="sub_128" type="float">
    <input name="in1" type="float" value="1.0" />
    <input name="in2" type="float" nodename="smooth_127" />
  </subtract>
  <multiply name="mul_129" type="float">
    <input name="in1" type="float" nodename="sub_128" />
    <input name="in2" type="float" value="0.8" />
  </multiply>
  <mix name="mixc_130" type="color3">
    <input name="fg" type="color3" value="0.45, 0.45, 0.47" />
    <input name="bg" type="color3" value="0.93, 0.92, 0.89" />
    <input name="mix" type="float" nodename="mul_129" />
  </mix>
  <standard_surface name="marble_shader_131" type="surfaceshader">
    <input name="base_color" type="color3" nodename="mixc_130" />
    <input name="specular" type="float" value="0.6" />
    <input name="specular_roughness" type="float" value="0.15" />
  </standard_surface>
  <surfacematerial name="marble" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="marble_shader_131" />
  </surfacematerial>

  <!-- ===== shingles: fish-scale shingles in the gable (Queen Anne) ===== -->
  <add name="add_132" type="float">
    <input name="in1" type="float" nodename="sep_1" output="outx" />
    <input name="in2" type="float" nodename="sep_1" output="outz" />
  </add>
  <divide name="div_133" type="float">
    <input name="in1" type="float" nodename="add_132" />
    <input name="in2" type="float" value="0.16" />
  </divide>
  <divide name="div_134" type="float">
    <input name="in1" type="float" nodename="sep_1" output="outy" />
    <input name="in2" type="float" value="0.12" />
  </divide>
  <floor name="floor_135" type="float">
    <input name="in" type="float" nodename="div_134" />
  </floor>
  <modulo name="mod_136" type="float">
    <input name="in1" type="float" nodename="floor_135" />
    <input name="in2" type="float" value="2.0" />
  </modulo>
  <multiply name="mul_137" type="float">
    <input name="in1" type="float" nodename="mod_136" />
    <input name="in2" type="float" value="0.5" />
  </multiply>
  <add name="add_138" type="float">
    <input name="in1" type="float" nodename="div_133" />
    <input name="in2" type="float" nodename="mul_137" />
  </add>
  <floor name="floor_139" type="float">
    <input name="in" type="float" nodename="add_138" />
  </floor>
  <subtract name="sub_140" type="float">
    <input name="in1" type="float" nodename="add_138" />
    <input name="in2" type="float" nodename="floor_139" />
  </subtract>
  <subtract name="sub_141" type="float">
    <input name="in1" type="float" nodename="sub_140" />
    <input name="in2" type="float" value="0.5" />
  </subtract>
  <divide name="div_142" type="float">
    <input name="in1" type="float" nodename="sep_1" output="outy" />
    <input name="in2" type="float" value="0.12" />
  </divide>
  <subtract name="sub_143" type="float">
    <input name="in1" type="float" nodename="div_142" />
    <input name="in2" type="float" nodename="floor_135" />
  </subtract>
  <subtract name="sub_144" type="float">
    <input name="in1" type="float" nodename="sub_143" />
    <input name="in2" type="float" value="0.5" />
  </subtract>
  <multiply name="mul_145" type="float">
    <input name="in1" type="float" nodename="sub_141" />
    <input name="in2" type="float" nodename="sub_141" />
  </multiply>
  <multiply name="mul_146" type="float">
    <input name="in1" type="float" nodename="sub_144" />
    <input name="in2" type="float" nodename="sub_144" />
  </multiply>
  <add name="add_147" type="float">
    <input name="in1" type="float" nodename="mul_145" />
    <input name="in2" type="float" nodename="mul_146" />
  </add>
  <smoothstep name="smooth_148" type="float">
    <input name="in" type="float" nodename="add_147" />
    <input name="low" type="float" value="0.16" />
    <input name="high" type="float" value="0.25" />
  </smoothstep>
  <ifgreater name="ifgt_149" type="float">
    <input name="value1" type="float" value="0.5" />
    <input name="value2" type="float" nodename="sub_143" />
    <input name="in1" type="float" value="1.0" />
    <input name="in2" type="float" value="0.0" />
  </ifgreater>
  <multiply name="mul_150" type="float">
    <input name="in1" type="float" nodename="smooth_148" />
    <input name="in2" type="float" nodename="ifgt_149" />
  </multiply>
  <floor name="floor_151" type="float">
    <input name="in" type="float" nodename="add_138" />
  </floor>
  <combine3 name="shingleid_152" type="vector3">
    <input name="in1" type="float" nodename="floor_151" />
    <input name="in2" type="float" nodename="floor_135" />
    <input name="in3" type="float" value="3.0" />
  </combine3>
  <cellnoise3d name="shinglecell_153" type="float">
    <input name="position" type="vector3" nodename="shingleid_152" />
  </cellnoise3d>
  <multiply name="mul_154" type="float">
    <input name="in1" type="float" nodename="mul_150" />
    <input name="in2" type="float" value="0.5" />
  </multiply>
  <subtract name="sub_155" type="float">
    <input name="in1" type="float" value="1.0" />
    <input name="in2" type="float" nodename="mul_154" />
  </subtract>
  <multiply name="mul_156" type="float">
    <input name="in1" type="float" nodename="shinglecell_153" />
    <input name="in2" type="float" value="0.12" />
  </multiply>
  <add name="add_157" type="float">
    <input name="in1" type="float" nodename="mul_156" />
    <input name="in2" type="float" value="0.9" />
  </add>
  <multiply name="mul_158" type="float">
    <input name="in1" type="float" nodename="sub_155" />
    <input name="in2" type="float" nodename="add_157" />
  </multiply>
  <multiply name="cmul_159" type="color3">
    <input name="in1" type="color3" nodename="paintcolour_13" />
    <input name="in2" type="float" nodename="mul_158" />
  </multiply>
  <standard_surface name="shingle_shader_160" type="surfaceshader">
    <input name="base_color" type="color3" nodename="cmul_159" />
    <input name="specular" type="float" value="0.35" />
    <input name="specular_roughness" type="float" value="0.6" />
  </standard_surface>
  <surfacematerial name="shingle" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="shingle_shader_160" />
  </surfacematerial>

  <!-- ===== roof: weathered tar ===== -->
  <normal name="Nworld_161" type="vector3">
    <input name="space" type="string" value="world" />
