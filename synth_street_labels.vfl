// =====================================================================
// synth_street_labels  —  Attribute Wrangle, Run Over: Primitives  (street level, feeding OUT_STREET)
// MODE "houses": makes each house's labels unique across the row: instance_id/parent_id += (house_id + 1) * 1000.
// MODE "street": the street and backdrop have no per-object identity, so they get "stuff" classes (no instance)
//                from their material:
//   11 road  12 sidewalk  13 vegetation  14 street_furniture  15 distant_building   0 background (sky, clouds)
// House classes 1-10 come from semantic_labels inside the HDA.
// =====================================================================
string MODE = "__MODE__";
if (MODE == "houses") {
    int base = (i@house_id + 1) * 1000;
    if (i@instance_id > 0) i@instance_id += base;
    if (i@parent_id > 0) i@parent_id += base;
} else {
    string m = s@material;
    int sem = 15;
    if (m == "asphalt" || m == "street_paint") sem = 11;
    else if (m == "sidewalk" || m == "granite" || m == "concrete") sem = 12;
    else if (m == "leaf" || m == "bark" || m == "soil" || m == "plant") sem = 13;
    else if (m == "metal" || m == "iron" || m == "lamp") sem = 14;
    else if (m == "clouds") sem = 0;
    i@semantic_id = sem; i@instance_id = 0; i@parent_id = 0;
}
